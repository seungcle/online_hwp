{
  "name": "rhwp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "dev:worker": "wrangler dev",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sample:edit": "esbuild samples/make-output.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sample-output.mjs --log-level=warning && node node_modules/.cache/sample-output.mjs",
    "ai:check": "esbuild samples/check-ai.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-ai.mjs --log-level=warning && node node_modules/.cache/check-ai.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.127.0"
  }
}

# wrangler dev 가 자동으로 읽는 로컬 전용 환경 변수.
#
#   cp .dev.vars.example .dev.vars
#   .dev.vars 에 진짜 키를 적는다
#   npm run dev:worker      # 127.0.0.1:8787 에서 /api/edit-plan 이 살아난다
#   npm run ai:check        # 실제 문서로 왕복 한 번 돌려 본다
#
# .dev.vars 는 gitignore 대상이다. 실서비스 키는 Cloudflare Secret에만 둔다.
OPENAI_API_KEY=sk-REPLACE_ME   # 여기에 진짜 키를 붙여넣는다

# 선택. 비워 두면 gpt-5.6-terra 를 쓴다.
# OPENAI_MODEL=gpt-5.6-terra
# 선택. 비워 두면 low. 추론을 지원하지 않는 모델을 쓸 때는 빈 값으로 둔다.
# OPENAI_REASONING_EFFORT=low

# wrangler dev 가 자동으로 읽는 로컬 전용 환경 변수.
#
#   cp .dev.vars.example .dev.vars
#   .dev.vars 에 진짜 키를 적는다
#   npm run dev:worker      # 127.0.0.1:8787 에서 /api/edit-plan 이 살아난다
#   npm run ai:check        # 실제 문서로 왕복 한 번 돌려 본다
#
# .dev.vars 는 gitignore 대상이다. 실서비스 키는 Cloudflare Secret에만 둔다.
# 아래 = 뒤에 키를 붙여넣는다. 주의할 것 두 가지.
#  - 같은 줄에 주석(#)을 달지 마라. 주석까지 값으로 들어간다.
#  - OpenAI 화면에 sk-proj-•••• 로 가려져 보이는 것을 복사하지 마라.
#    키 전체 값은 발급 직후 한 번만 보인다.
OPENAI_API_KEY=

# 선택. 비워 두면 gpt-5.6-terra 를 쓴다.
# OPENAI_MODEL=gpt-5.6-terra
# 선택. 비워 두면 low. 추론을 지원하지 않는 모델을 쓸 때는 빈 값으로 둔다.
# OPENAI_REASONING_EFFORT=low

# AI 호출을 쓸 수 있는 아이디와 비밀번호.
# 저장소가 공개라 코드에 적지 않는다. 운영에서는 Cloudflare Secret으로 넣는다.
#   npx wrangler secret put APP_USER
#   npx wrangler secret put APP_PASSWORD
# 설정하지 않으면 /api/edit-plan 이 503을 준다.
APP_USER=your-id
APP_PASSWORD=your-password

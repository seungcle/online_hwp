{
  // Cloudflare Workers Builds가 `npm run build` 후 `npx wrangler deploy`로 배포한다.
  // Worker 이름은 rhwp.co.kr 도메인이 붙어 있는 기존 서비스 이름이므로 바꾸면 안 된다.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "online-hwp",
  "main": "backend/index.ts",
  "compatibility_date": "2026-06-19",
  "observability": { "enabled": true },
  // 알려진 양식 저장소. 원본 HWPX·이미지·본문은 넣지 않는다. 스키마는 migrations/.
  // 바인딩이 없어도 서비스는 돈다 — 매번 처음 보는 문서로 처리될 뿐이다.
  "d1_databases": [
    {
      "binding": "TEMPLATES",
      "database_name": "rhwp-templates",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // 없는 경로에서 index.html을 200으로 돌려주던 기존 동작을 유지한다.
    "not_found_handling": "single-page-application",
    // 이 두 경로만 Worker가 먼저 받는다. 나머지는 정적 자산이 바로 응답한다.
    //  - /api/*   : OpenAI 프록시
    //  - /naver*  : 소유확인 파일을 307 없이 200으로
    "run_worker_first": ["/api/*", "/naver*"]
  }
}
